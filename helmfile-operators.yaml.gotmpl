---
# Shared operators (CloudNativePG, Stackable). Sync once per cluster.
environments:
  local:
    values: []
---
helmfiles:
  - path: '{{ env "CIVITAS_CORE_DEPLOYMENT" | default "../civitas-core-deployment" }}/helmfile-root.yaml.gotmpl'
    values:
      - values/default-instance.yaml
      # Comma-separated EXTRA_VALUES files are layered on top.
      {{- range (env "EXTRA_VALUES" | splitList "," | compact) }}
      - {{ . | quote }}
      {{- end }}
      - environments:
          - local
        deployLayer: operators
        components:
          - prepare
          - postgres
          - stackable
          - networkpolicies
        global:
          operators:
            watchAllNamespaces: true
