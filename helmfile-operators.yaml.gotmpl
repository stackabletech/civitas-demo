---
# The operators (PostgreSQL and Stackable). Install them once per cluster.
environments:
  local:
    values: []
---
helmfiles:
  - path: '{{ env "CIVITAS_CORE_DEPLOYMENT" | default "../civitas-core-deployment" }}/helmfile-root.yaml.gotmpl'
    values:
      - values/default-instance.yaml
      # Extra values files from EXTRA_VALUES (comma separated) win over the ones above.
      {{- range (env "EXTRA_VALUES" | splitList "," | compact) }}
      - {{ . | quote }}
      {{- end }}
      - environments:
          - local
        deployLayer: operators
        components:
          - prepare
          - postgres
          - stackable
          - networkpolicies
        global:
          operators:
            watchAllNamespaces: true
